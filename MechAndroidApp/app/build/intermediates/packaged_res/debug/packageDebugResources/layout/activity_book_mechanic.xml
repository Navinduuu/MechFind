<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAEAEA">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/layoutTopBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FDF8F8"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="50dp"
        android:paddingBottom="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:padding="8dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:tint="#555555"
                app:srcCompat="@drawable/back" />
        </LinearLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Booking Details"
            android:textColor="#1A1A1A"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginEnd="40dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutTopBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Mechanic Summary -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Booking for:"
                android:textColor="#808080"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvBookingMechanicName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="John Doe - Auto Electrician"
                android:textColor="#1A1A1A"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="24dp" />

            <!-- Input Fields -->
            <EditText
                android:id="@+id/etVehicleMake"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/edittext_rounded"
                android:backgroundTint="#FFFFFF"
                android:hint="Vehicle Make &amp; Model (e.g. Toyota Aqua)"
                android:textColor="#1A1A1A"
                android:textColorHint="#C4C4C4"
                android:paddingHorizontal="16dp"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/etBookingDate"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/edittext_rounded"
                android:backgroundTint="#FFFFFF"
                android:focusable="false"
                android:hint="Select Date"
                android:textColor="#1A1A1A"
                android:textColorHint="#C4C4C4"
                android:paddingHorizontal="16dp"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/etBookingTime"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/edittext_rounded"
                android:backgroundTint="#FFFFFF"
                android:focusable="false"
                android:hint="Select Time"
                android:textColor="#1A1A1A"
                android:textColorHint="#C4C4C4"
                android:paddingHorizontal="16dp"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/etIssueDescription"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/edittext_rounded"
                android:backgroundTint="#FFFFFF"
                android:gravity="top|start"
                android:hint="Describe your issue..."
                android:inputType="textMultiLine"
                android:padding="16dp"
                android:textColor="#1A1A1A"
                android:textColorHint="#C4C4C4"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/etLocationAddress"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/edittext_rounded"
                android:backgroundTint="#FFFFFF"
                android:hint="Service Address/Location"
                android:textColor="#1A1A1A"
                android:textColorHint="#C4C4C4"
                android:paddingHorizontal="16dp"
                android:textSize="16sp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="32dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnConfirmBooking"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/btn_signup_rounded"
                android:text="Confirm Booking"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="24dp" />

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>